<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ZenPay"
        android:usesCleartextTraffic="true">
        <!-- Cleartext HTTP only ever talks to 127.0.0.1 (via `adb reverse`)
             or a LAN IP you type into Settings yourself — this app never
             ships with a real remote endpoint, so blanket cleartext is fine
             for a local test tool that will never see the Play Store. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="Sign in"
            android:launchMode="singleTask">
            <!-- Catches Google/Supabase's OAuth redirect (AuthClient.kt).
                 exported=true + BROWSABLE is required so the device's
                 browser can hand control back to this app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zenpay" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="Past transactions"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".MyQrActivity"
            android:exported="false"
            android:label="My ZenPay ID"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:label="Scan a ZenPay ID"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SendMoneyActivity"
            android:exported="false"
            android:label="Send fake money"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
